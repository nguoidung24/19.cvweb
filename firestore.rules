rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check endpoint (read-only)
    match /test/connection {
      allow get: if true;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'dungtamtithoi24@gmail.com';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isActiveUser() {
      return isBootstrappedAdmin() || (
        isVerified() &&
        userExists(request.auth.uid) &&
        userDoc(request.auth.uid).data.isActive == true
      );
    }

    function hasRole(role) {
      return isVerified() && userExists(request.auth.uid) && userDoc(request.auth.uid).data.isActive == true && (role in userDoc(request.auth.uid).data.roles);
    }

    function isAdmin() {
      return isBootstrappedAdmin() || hasRole('ADMIN');
    }

    function isLeadership() {
      return isAdmin() || hasRole('TRUONG_PHONG') || hasRole('PHO_PHONG');
    }

    function isGroupLeader(groupId) {
      return isActiveUser() && hasRole('TRUONG_NHOM') && userDoc(request.auth.uid).data.groupId == groupId;
    }

    function isProjectManager(projectId) {
      return projectId != '' &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.pmId == request.auth.uid;
    }

    function isProjectMember(projectId) {
      return projectId != '' &&
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    // Vietnam Time (UTC+7) helpers for WorkLog date lock
    function vnTime() {
      return request.time + duration.time(7, 0, 0, 0);
    }

    function vnTodayNum() {
      return vnTime().year() * 10000 + vnTime().month() * 100 + vnTime().day();
    }

    function hasWorkLogUnlock(uid, workDate) {
      return exists(/databases/$(database)/documents/workLogUnlocks/$(uid + '_' + workDate));
    }

    function isWorkLogDateEditable(uid, workDate, workDateNum) {
      return isAdmin() || (
        workDateNum <= vnTodayNum() && (
          workDateNum == vnTodayNum() ||
          hasWorkLogUnlock(uid, workDate)
        )
      );
    }

    // --- Validation Blueprints ---
    function isValidRolesList(roles) {
      return roles is list &&
        roles.size() >= 1 &&
        roles.size() <= 6 &&
        roles.hasOnly(['ADMIN', 'TRUONG_PHONG', 'PHO_PHONG', 'QUAN_LY_DU_AN', 'TRUONG_NHOM', 'CHUYEN_VIEN']);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'employeeCode', 'fullName', 'roles', 'isActive', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'authUid', 'employeeCode', 'fullName', 'title', 'roles', 'groupId', 'managerId', 'isActive', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        (!('authUid' in data) || (data.authUid is string && data.authUid.size() <= 128)) &&
        data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 32 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
        isValidRolesList(data.roles) &&
        (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 64)) &&
        (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 128)) &&
        data.isActive is bool &&
        data.departmentId == 'DAMA2' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'authUid', 'email', 'phone', 'updatedAt']) &&
        isValidId(data.uid) &&
        (!('authUid' in data) || (data.authUid is string && data.authUid.size() <= 128)) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        data.updatedAt is timestamp;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'leaderId', 'memberUids', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'description', 'leaderId', 'memberUids', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.leaderId is string && data.leaderId.size() <= 128 &&
        data.memberUids is list && data.memberUids.size() <= 50 &&
        (data.memberUids.size() == 0 || data.memberUids[0] is string) &&
        data.departmentId == 'DAMA2' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'status', 'pmId', 'memberIds', 'createdBy', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'description', 'startDate', 'expectedEndDate', 'status', 'pmId', 'memberIds', 'labels', 'createdBy', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20)) &&
        (!('expectedEndDate' in data) || (data.expectedEndDate is string && data.expectedEndDate.size() <= 20)) &&
        data.status in ['CHUAN_BI', 'DANG_THUC_HIEN', 'TAM_DUNG', 'HOAN_THANH', 'DONG'] &&
        isValidId(data.pmId) &&
        data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50 && data.memberIds[0] is string &&
        (!('labels' in data) || (data.labels is list && data.labels.size() <= 15 && (data.labels.size() == 0 || data.labels[0] is string))) &&
        isValidId(data.createdBy) &&
        data.departmentId == 'DAMA2' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProjectMember(data) {
      return data.keys().hasAll(['userId', 'projectRole', 'joinedAt']) &&
        data.keys().hasOnly(['userId', 'projectRole', 'joinedAt']) &&
        isValidId(data.userId) &&
        data.projectRole in ['QUAN_LY_DU_AN', 'THANH_VIEN'] &&
        data.joinedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'id', 'code', 'title', 'groupId', 'creatorId', 'assigneeId', 'reviewerId',
          'priority', 'status', 'submissionStatus', 'reviewResult', 'isLocked',
          'participantIds', 'departmentId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'title', 'description', 'projectId', 'groupId',
          'creatorId', 'assigneeId', 'reviewerId', 'parentTaskId', 'priority',
          'startDate', 'dueDate', 'estimatedHours', 'labels', 'attachments',
          'status', 'submissionStatus', 'submissionNote', 'reviewResult', 'reviewNote',
          'isLocked', 'participantIds', 'departmentId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 32 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 64)) &&
        data.groupId is string && data.groupId.size() <= 64 &&
        isValidId(data.creatorId) &&
        isValidId(data.assigneeId) &&
        isValidId(data.reviewerId) &&
        (!('parentTaskId' in data) || (data.parentTaskId is string && data.parentTaskId.size() <= 64)) &&
        data.priority in ['THAP', 'TRUNG_BINH', 'CAO', 'KHAN_CAP'] &&
        (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 20)) &&
        (!('estimatedHours' in data) || (data.estimatedHours is number && data.estimatedHours >= 0 && data.estimatedHours <= 10000)) &&
        (!('labels' in data) || (data.labels is list && data.labels.size() <= 10 && (data.labels.size() == 0 || data.labels[0] is string))) &&
        (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 10 && (data.attachments.size() == 0 || data.attachments[0] is string))) &&
        data.status in ['MOI', 'DANG_THUC_HIEN', 'CHO_XAC_NHAN', 'CHUA_HOAN_THANH', 'HOAN_THANH', 'TAM_HOAN', 'HUY'] &&
        data.submissionStatus in ['CHUA_NOP', 'DA_NOP'] &&
        (!('submissionNote' in data) || (data.submissionNote is string && data.submissionNote.size() <= 1000)) &&
        data.reviewResult in ['CHO_XAC_NHAN', 'DA_HOAN_THANH', 'CHUA_HOAN_THANH'] &&
        (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 1000)) &&
        data.isLocked is bool &&
        data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 && data.participantIds[0] is string &&
        data.departmentId == 'DAMA2' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubtask(data) {
      return data.keys().hasAll(['id', 'title', 'isDone', 'createdBy', 'taskParticipantIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'isDone', 'createdBy', 'taskParticipantIds', 'createdAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.isDone is bool &&
        isValidId(data.createdBy) &&
        data.taskParticipantIds is list && data.taskParticipantIds.size() >= 1 && data.taskParticipantIds.size() <= 50 && data.taskParticipantIds[0] is string &&
        data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'content', 'taskParticipantIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'authorId', 'authorName', 'content', 'mentions', 'taskParticipantIds', 'createdAt']) &&
        isValidId(data.id) &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
        (!('mentions' in data) || (data.mentions is list && data.mentions.size() <= 20 && (data.mentions.size() == 0 || data.mentions[0] is string))) &&
        data.taskParticipantIds is list && data.taskParticipantIds.size() >= 1 && data.taskParticipantIds.size() <= 50 && data.taskParticipantIds[0] is string &&
        data.createdAt is timestamp;
    }

    function isValidTaskAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'actorName', 'action', 'detail', 'taskParticipantIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorId', 'actorName', 'action', 'detail', 'taskParticipantIds', 'createdAt']) &&
        isValidId(data.id) &&
        data.actorId == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 1000 &&
        data.taskParticipantIds is list && data.taskParticipantIds.size() >= 1 && data.taskParticipantIds.size() <= 50 && data.taskParticipantIds[0] is string &&
        data.createdAt is timestamp;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['id', 'email', 'targetUserId', 'roles', 'fullName', 'employeeCode', 'isActive', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'targetUserId', 'roles', 'groupId', 'managerId', 'fullName', 'employeeCode', 'title', 'isActive', 'createdAt']) &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidId(data.targetUserId) &&
        isValidRolesList(data.roles) &&
        (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 64)) &&
        (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 128)) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 32 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    function isValidWorkLog(data) {
      return data.keys().hasAll(['id', 'userId', 'taskId', 'workDate', 'workDateNum', 'hours', 'note', 'viewerIds', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'taskId', 'projectId', 'workDate', 'workDateNum', 'hours', 'progressPercent', 'note', 'viewerIds', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.taskId) &&
        (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 64)) &&
        data.workDate is string && data.workDate.size() == 10 && data.workDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.workDateNum is int && data.workDateNum >= 20200101 && data.workDateNum <= 21001231 &&
        data.hours is number && data.hours > 0 && data.hours <= 24 &&
        (!('progressPercent' in data) || (data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100)) &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 1000 &&
        data.viewerIds is list && data.viewerIds.size() >= 1 && data.viewerIds.size() <= 30 && data.viewerIds[0] is string &&
        data.departmentId == 'DAMA2' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkLogUnlock(data) {
      return data.keys().hasAll(['id', 'userId', 'workDate', 'unlockedBy', 'reason', 'departmentId', 'unlockedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'workDate', 'unlockedBy', 'reason', 'departmentId', 'unlockedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.workDate is string && data.workDate.size() == 10 && data.workDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.id == (data.userId + '_' + data.workDate) &&
        data.unlockedBy == request.auth.uid &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500 &&
        data.departmentId == 'DAMA2' &&
        data.unlockedAt is timestamp;
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['lockHour', 'lockMinute', 'reminderHour', 'reminderMinute', 'timezone', 'defaultLabels', 'updatedAt']) &&
        data.keys().hasOnly(['lockHour', 'lockMinute', 'reminderHour', 'reminderMinute', 'timezone', 'defaultLabels', 'holidays', 'updatedBy', 'updatedAt']) &&
        data.lockHour is int && data.lockHour >= 0 && data.lockHour <= 23 &&
        data.lockMinute is int && data.lockMinute >= 0 && data.lockMinute <= 59 &&
        data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23 &&
        data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59 &&
        data.timezone is string && data.timezone.size() <= 40 &&
        data.defaultLabels is list && data.defaultLabels.size() <= 30 && (data.defaultLabels.size() == 0 || data.defaultLabels[0] is string) &&
        (!('holidays' in data) || (data.holidays is list && data.holidays.size() <= 50 && (data.holidays.size() == 0 || data.holidays[0] is string))) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'actorName', 'action', 'targetType', 'targetId', 'detail', 'viewerIds', 'departmentId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorId', 'actorName', 'action', 'targetType', 'targetId', 'detail', 'viewerIds', 'departmentId', 'createdAt']) &&
        isValidId(data.id) &&
        data.actorId == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 1000 &&
        data.viewerIds is list && data.viewerIds.size() >= 1 && data.viewerIds.size() <= 30 && data.viewerIds[0] is string &&
        data.departmentId == 'DAMA2' &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Department Directory snapshot (non-PII, readable by active department members)
    match /directories/{dirId} {
      allow get: if isValidId(dirId) && isActiveUser();
      allow create, update: if isValidId(dirId) && isAdmin() &&
        incoming().keys().hasAll(['departmentId', 'updatedAt']) &&
        incoming().keys().hasOnly(['departmentId', 'members', 'updatedAt']) &&
        incoming().departmentId == 'DAMA2' &&
        incoming().updatedAt == request.time;
    }

    // Users (non-PII org directory)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isActiveUser() || (isVerified() && userId == request.auth.uid));
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.departmentId == 'DAMA2');

      allow create: if isValidId(userId) &&
        isVerified() &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isBootstrappedAdmin() && userId == request.auth.uid) ||
          (
            userId == request.auth.uid &&
            exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_'))) &&
            incoming().roles == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_'))).data.roles &&
            incoming().isActive == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_'))).data.isActive
          )
        );

      allow update: if isValidId(userId) &&
        isVerified() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'title', 'updatedAt']))
        );

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerified() && (userId == request.auth.uid || isLeadership());
        allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.uid == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(docId) && isVerified() && isValidUserPrivate(incoming()) && incoming().updatedAt == request.time && (isAdmin() || userId == request.auth.uid);
        allow update: if isValidId(userId) && isValidId(docId) && isVerified() && isValidUserPrivate(incoming()) && incoming().uid == existing().uid && incoming().updatedAt == request.time && (isAdmin() || userId == request.auth.uid);
      }
    }

    // Work Groups (4 groups)
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isActiveUser();
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.memberUids);

      allow create: if isValidId(groupId) && isAdmin() && isValidGroup(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(groupId) && isAdmin() && isValidGroup(incoming()) && incoming().id == existing().id && incoming().departmentId == existing().departmentId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    // Projects
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isActiveUser() && (isLeadership() || isProjectMember(projectId) || resource.data.pmId == request.auth.uid || request.auth.uid in resource.data.memberIds);
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.memberIds);

      allow create: if isValidId(projectId) &&
        isActiveUser() &&
        isValidProject(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isLeadership() || hasRole('QUAN_LY_DU_AN')
        );

      allow update: if isValidId(projectId) &&
        isActiveUser() &&
        isValidProject(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isLeadership() ||
          (existing().pmId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'startDate', 'expectedEndDate', 'status', 'memberIds', 'labels', 'updatedAt']))
        );

      match /members/{memberId} {
        allow get: if isValidId(projectId) && isValidId(memberId) && isActiveUser() && (isLeadership() || isProjectMember(projectId) || isProjectManager(projectId));
        allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);
        allow create, update: if isValidId(projectId) && isValidId(memberId) && isActiveUser() && isValidProjectMember(incoming()) && incoming().joinedAt == request.time && (isLeadership() || isProjectManager(projectId));
        allow delete: if isValidId(projectId) && isValidId(memberId) && isActiveUser() && (isLeadership() || isProjectManager(projectId));
      }
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isActiveUser() && (
        isLeadership() ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.assigneeId == request.auth.uid ||
        resource.data.reviewerId == request.auth.uid ||
        request.auth.uid in resource.data.participantIds ||
        isProjectManager(resource.data.projectId) ||
        isGroupLeader(resource.data.groupId)
      );
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.participantIds);

      allow create: if isValidId(taskId) &&
        isActiveUser() &&
        isValidTask(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('projectId' in incoming()) || incoming().projectId == '' || exists(/databases/$(database)/documents/projects/$(incoming().projectId))) && (
          isAdmin() || (
            incoming().creatorId == request.auth.uid &&
            incoming().isLocked == false &&
            incoming().status in ['MOI', 'DANG_THUC_HIEN'] &&
            incoming().submissionStatus == 'CHUA_NOP' &&
            incoming().reviewResult == 'CHO_XAC_NHAN' && (
              // Self-created task by any active user (only for themselves)
              incoming().assigneeId == request.auth.uid ||
              // Leadership can assign to anyone
              isLeadership() ||
              // Project Manager can assign within their project
              isProjectManager(incoming().projectId) ||
              // Group Leader can assign within their group
              isGroupLeader(incoming().groupId)
            )
          )
        );

      allow update: if isValidId(taskId) &&
        isActiveUser() &&
        isValidTask(incoming()) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().creatorId == existing().creatorId &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Admin full override
          isAdmin() ||
          // Action 1: Reopen locked completed task (Leadership or Reviewer only, requires reviewNote)
          (
            existing().isLocked == true &&
            incoming().isLocked == false &&
            incoming().status == 'DANG_THUC_HIEN' &&
            incoming().submissionStatus == 'CHUA_NOP' &&
            incoming().reviewResult == 'CHUA_HOAN_THANH' &&
            'reviewNote' in incoming() && incoming().reviewNote.size() >= 3 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'submissionStatus', 'reviewResult', 'reviewNote', 'isLocked', 'updatedAt']) &&
            (isLeadership() || existing().reviewerId == request.auth.uid)
          ) ||
          // Action 2: Assignee works on task or submits result (NEVER self-approve to HOAN_THANH)
          (
            existing().isLocked == false &&
            existing().assigneeId == request.auth.uid &&
            incoming().status in ['MOI', 'DANG_THUC_HIEN', 'CHO_XAC_NHAN', 'TAM_HOAN'] &&
            incoming().isLocked == false &&
            incoming().reviewResult == existing().reviewResult &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'submissionStatus', 'submissionNote', 'attachments', 'updatedAt'])
          ) ||
          // Action 3: Reviewer / Manager confirms or rejects submission
          (
            existing().isLocked == false &&
            (isLeadership() || existing().reviewerId == request.auth.uid || isProjectManager(existing().projectId) || isGroupLeader(existing().groupId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'submissionStatus', 'reviewResult', 'reviewNote', 'isLocked', 'updatedAt']) &&
            (
              (incoming().status == 'HOAN_THANH' && incoming().reviewResult == 'DA_HOAN_THANH' && incoming().isLocked == true) ||
              (incoming().status == 'CHUA_HOAN_THANH' && incoming().submissionStatus == 'CHUA_NOP' && incoming().reviewResult == 'CHUA_HOAN_THANH' && incoming().isLocked == false && 'reviewNote' in incoming() && incoming().reviewNote.size() >= 3) ||
              (incoming().status in ['DANG_THUC_HIEN', 'TAM_HOAN', 'HUY'] && incoming().isLocked == false)
            )
          ) ||
          // Action 4: Creator / Manager edits task metadata while unlocked
          (
            existing().isLocked == false &&
            (isLeadership() || existing().creatorId == request.auth.uid || isProjectManager(existing().projectId) || isGroupLeader(existing().groupId)) &&
            incoming().status == existing().status &&
            incoming().submissionStatus == existing().submissionStatus &&
            incoming().reviewResult == existing().reviewResult &&
            incoming().isLocked == existing().isLocked &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'projectId', 'groupId', 'assigneeId', 'reviewerId',
              'priority', 'startDate', 'dueDate', 'estimatedHours', 'labels', 'attachments', 'participantIds', 'updatedAt'
            ])
          )
        );

      match /subtasks/{subtaskId} {
        allow get: if isValidId(taskId) && isValidId(subtaskId) && isActiveUser() && (
          isLeadership() ||
          request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.participantIds
        );
        allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.taskParticipantIds);
        allow create, update: if isValidId(taskId) && isValidId(subtaskId) && isActiveUser() && isValidSubtask(incoming()) && (
          isAdmin() || (
            get(/databases/$(database)/documents/tasks/$(taskId)).data.isLocked == false &&
            (isLeadership() || request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.participantIds)
          )
        );
        allow delete: if isValidId(taskId) && isValidId(subtaskId) && isActiveUser() && (isLeadership() || resource.data.createdBy == request.auth.uid);
      }

      match /comments/{commentId} {
        allow get: if isValidId(taskId) && isValidId(commentId) && isActiveUser() && (
          isLeadership() ||
          request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.participantIds
        );
        allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.taskParticipantIds);
        allow create: if isValidId(taskId) && isValidId(commentId) && isActiveUser() && isValidComment(incoming()) &&
          incoming().createdAt == request.time &&
          (isLeadership() || request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.participantIds);
      }

      match /auditLogs/{logId} {
        allow get: if isValidId(taskId) && isValidId(logId) && isActiveUser() && (
          isLeadership() ||
          request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.participantIds
        );
        allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.taskParticipantIds);
        allow create: if isValidId(taskId) && isValidId(logId) && isActiveUser() && isValidTaskAuditLog(incoming()) && incoming().createdAt == request.time;
      }
    }

    // Invites (Admin creates; invited user reads their own invite doc by exact ID)
    match /invites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerified() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.email == request.auth.token.email);
      allow create, update: if isValidId(inviteId) && isAdmin() && isValidInvite(incoming()) && incoming().createdAt == request.time;
      allow delete: if isValidId(inviteId) && isAdmin();
    }

    // WorkLogs (enforces Vietnam UTC+7 date lock on server)
    match /workLogs/{logId} {
      allow get: if isValidId(logId) && isActiveUser() && (
        isLeadership() ||
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.viewerIds
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.viewerIds
      );

      allow create: if isValidId(logId) &&
        isActiveUser() &&
        isValidWorkLog(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/tasks/$(incoming().taskId)) &&
        (isAdmin() || incoming().userId == request.auth.uid) &&
        isWorkLogDateEditable(incoming().userId, incoming().workDate, incoming().workDateNum);

      allow update: if isValidId(logId) &&
        isActiveUser() &&
        isValidWorkLog(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().workDate == existing().workDate &&
        incoming().workDateNum == existing().workDateNum &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() || existing().userId == request.auth.uid) &&
        isWorkLogDateEditable(existing().userId, existing().workDate, existing().workDateNum);

      allow delete: if isValidId(logId) &&
        isActiveUser() &&
        (isAdmin() || existing().userId == request.auth.uid) &&
        isWorkLogDateEditable(existing().userId, existing().workDate, existing().workDateNum);
    }

    // WorkLog Unlocks (Admin or Trưởng/Phó phòng only)
    match /workLogUnlocks/{unlockId} {
      allow get: if isValidId(unlockId) && isActiveUser() && (isLeadership() || resource.data.userId == request.auth.uid);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid || resource.data.unlockedBy == request.auth.uid);
      allow create, update: if isValidId(unlockId) &&
        isLeadership() &&
        isValidWorkLogUnlock(incoming()) &&
        unlockId == incoming().id &&
        incoming().unlockedAt == request.time;
      allow delete: if isValidId(unlockId) && isLeadership();
    }

    // System Configs
    match /systemConfigs/{configId} {
      allow get: if isValidId(configId) && isActiveUser();
      allow create, update: if isValidId(configId) && isAdmin() && isValidSystemConfig(incoming()) && incoming().updatedAt == request.time;
    }

    // System Audit Logs
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isActiveUser() && (isLeadership() || request.auth.uid in resource.data.viewerIds);
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerIds);
      allow create: if isValidId(logId) && isActiveUser() && isValidAuditLog(incoming()) && incoming().createdAt == request.time;
    }
  }
}
